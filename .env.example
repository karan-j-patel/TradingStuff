# Copy to .env and fill in. .env is gitignored — never commit it,
# never paste it into a chat window, and never put values in THIS file.
# .env.example is committed; .env is not. That asymmetry is the whole point.

# --- Sharadar -----------------------------------------------------------
# Two separate channels exist and their keys are NOT interchangeable:
#   api.sharadar.com     retail direct  (launched 2026-07) — this is ours
#   data.nasdaq.com      institutional  — a sharadar.com key 429s here,
#                                         because it is never recognised and
#                                         falls through to anonymous limits
# Free tier: all tickers, rolling 5-year window. Point-in-time works via the
# `date` column (filing date) and dimension=ARQ (as-reported, not restated).
SHARADAR_API_KEY=

# --- Alpaca -------------------------------------------------------------
# Generate under Paper Account -> API Keys in the dashboard. These are NOT
# the CLI's credentials: `alpaca profile login` uses OAuth and stores a token
# at ~/.config/alpaca/profiles/paper.yaml with api_key/secret_key left empty.
#
# NOTE: the Alpaca CLI reads ALPACA_API_KEY / ALPACA_SECRET_KEY. The names
# below are ours and the CLI will not pick them up — deliberate, so that our
# code and the CLI cannot accidentally trade through each other's credentials.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets

# Account recovery key. Higher value than the API keys above — it recovers the
# account itself, not just API access. Consider a password manager instead of
# this file; kept here only if you want a single source of truth.
ALPACA_RECOVERY_KEY=

# --- Local --------------------------------------------------------------
DATA_ROOT=./data
OLLAMA_HOST=http://localhost:11434
